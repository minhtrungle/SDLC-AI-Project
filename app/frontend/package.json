{
  "name": "chat-with-docs-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --build && vite build",
    "type-check": "vue-tsc --build",
    "lint": "eslint .",
    "test": "vitest run --coverage",
    "gen:api": "openapi-typescript ../api-contract/openapi.yaml -o src/api/schema.d.ts",
    "check:api": "node scripts/check-api.mjs"
  },
  "dependencies": {
    "vue": "3.5.44"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@vitejs/plugin-vue": "6.0.10",
    "@vitest/coverage-v8": "5.0.4",
    "@vue/test-utils": "2.5.1",
    "@vue/tsconfig": "0.9.1",
    "eslint": "10.12.0",
    "eslint-plugin-vue": "10.11.1",
    "jsdom": "30.1.2",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.4",
    "vue-eslint-parser": "10.4.1",
    "vue-tsc": "3.3.13"
  }
}

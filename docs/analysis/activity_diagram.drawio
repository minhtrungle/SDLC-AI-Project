<mxfile host="app.diagrams.net" agent="Claude Code" version="24.0.0"><diagram id="act1" name="Activity 1 - Nạp tài liệu (Luồng B)"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="2000" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="act1-v2" value="Activity Diagram — Nạp tài liệu PDF (US-201..203, Luồng B)" style="fontFamily=Arial;text;html=1;fontSize=16;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="8" width="1100" height="24" as="geometry"/></mxCell><mxCell id="act1-v3" value="Nguồn: SAD-CWD-001 §2.2 (pipeline nạp), §3.2 Luồng B, §4.2 (retry/idempotent). Hình thoi vàng = quyết định/hợp nhất; thanh đen = fork/join; nét đứt = object flow; đỏ đứt = exception." style="fontFamily=Arial;text;html=1;fontSize=10;fontStyle=2;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="32" width="1300" height="18" as="geometry"/></mxCell><mxCell id="act1-v4" value="Người dùng (Linh) · Web SPA" style="fontFamily=Arial;swimlane;html=1;startSize=34;fillColor=#D5E8D4;strokeColor=#82b366;swimlaneFillColor=#F4FAF2;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="56" width="260" height="1900" as="geometry"/></mxCell><mxCell id="act1-v5" value="API Service · module Documents" style="fontFamily=Arial;swimlane;html=1;startSize=34;fillColor=#D5E8D4;strokeColor=#82b366;swimlaneFillColor=#F4FAF2;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="300" y="56" width="320" height="1900" as="geometry"/></mxCell><mxCell id="act1-v6" value="Worker · Ingestion pipeline" style="fontFamily=Arial;swimlane;html=1;startSize=34;fillColor=#D5E8D4;strokeColor=#82b366;swimlaneFillColor=#F4FAF2;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="620" y="56" width="440" height="1900" as="geometry"/></mxCell><mxCell id="act1-v7" value="Hạ tầng: Object Storage · PostgreSQL · ModelGateway" style="fontFamily=Arial;swimlane;html=1;startSize=34;fillColor=#D5E8D4;strokeColor=#82b366;swimlaneFillColor=#F4FAF2;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1060" y="56" width="380" height="1900" as="geometry"/></mxCell><mxCell id="act1-v8" value="" style="fontFamily=Arial;ellipse;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="158" y="118" width="24" height="24" as="geometry"/></mxCell><mxCell id="act1-v9" value="Chọn / kéo-thả tệp PDF&lt;br&gt;&lt;i&gt;(UI kiểm sơ bộ định dạng, dung lượng)&lt;/i&gt;" style="fontFamily=Arial;rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#DAE8FC;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="82" y="193" width="176" height="54" as="geometry"/></mxCell><mxCell id="act1-v10" value="POST /v1/documents — kiểm tra magic bytes &lt;b&gt;%PDF-&lt;/b&gt;, kích thước ≤ MAX_FILE_MB, tổng ≤ MAX_DOCS" style="fontFamily=Arial;rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#DAE8FC;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="372" y="277" width="176" height="66" as="geometry"/></mxCell><mxCell id="act1-v11" value="Tệp hợp lệ?" style="fontFamily=Arial;rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1"><mxGeometry x="376" y="364" width="168" height="72" as="geometry"/></mxCell><mxCell id="act1-v12" value="Hiển thị lỗi nghiệp vụ&lt;br&gt;415 / 413 / 409 limit_reached" style="fontFamily=Arial;rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#F8CECC;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="82" y="373" width="176" height="54" as="geometry"/></mxCell><mxCell id="act1-v13" value="" style="fontFamily=Arial;ellipse;html=1;shape=endState;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="155" y="475" width="30" height="30" as="geometry"/></mxCell><mxCell id="act1-v14" value="Ghi PDF vào &lt;b&gt;Object Storage&lt;/b&gt;&lt;br&gt;ws/{workspace_id}/docs/{doc_id}.pdf" style="fontFamily=Arial;rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#DAE8FC;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1162" y="463" width="176" height="54" as="geometry"/></mxCell><mxCell id="act1-v15" value="INSERT Document (status = processing)&lt;br&gt;enqueue ProcessDocument(doc_id)" style="fontFamily=Arial;rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#DAE8FC;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="372" y="553" width="176" height="54" as="geometry"/></mxCell><mxCell id="act1-v16" value="«datastore» PostgreSQL&lt;br&gt;Document [processing]" style="fontFamily=Arial;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#666666;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1175" y="560" width="150" height="40" as="geometry"/></mxCell><mxCell id="act1-v17" value="" style="fontFamily=Arial;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="345" y="666" width="230" height="8" as="geometry"/></mxCell><mxCell id="act1-v18" value="Nhận &lt;b&gt;202 Accepted&lt;/b&gt; {id}&lt;br&gt;Hiển thị trạng thái “Đang xử lý”" style="fontFamily=Arial;rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#DAE8FC;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="82" y="733" width="176" height="54" as="geometry"/></mxCell><mxCell id="act1-v19" value="Nhận job từ hàng đợi Redis&lt;br&gt;Tải PDF từ Object Storage" style="fontFamily=Arial;rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#DAE8FC;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="652" y="733" width="176" height="54" as="geometry"/></mxCell><mxCell id="act1-v20" value="Trích xuất văn bản &lt;b&gt;theo từng trang&lt;/b&gt; (PyMuPDF)" style="fontFamily=Arial;rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#DAE8FC;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="652" y="823" width="176" height="54" as="geometry"/></mxCell><mxCell id="act1-v21" value="PDF có mật khẩu /&lt;br&gt;không có văn bản?" style="fontFamily=Arial;rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1"><mxGeometry x="656" y="904" width="168" height="72" as="geometry"/></mxCell><mxCell id="act1-v22" value="status = &lt;b&gt;password&lt;/b&gt; | &lt;b&gt;no_text&lt;/b&gt;&lt;br&gt;(AC-203.5, EC-11)" style="fontFamily=Arial;rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#F8CECC;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="862" y="913" width="176" height="54" as="geometry"/></mxCell><mxCell id="act1-v23" value="Làm sạch Unicode &lt;b&gt;NFC&lt;/b&gt;, bỏ header/footer lặp. Chia chunk ~500 token, giữ page_start/page_end" style="fontFamily=Arial;rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#DAE8FC;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="652" y="997" width="176" height="66" as="geometry"/></mxCell><mxCell id="act1-v24" value="embed(lô ≤ 64 chunk)&lt;br&gt;ModelGateway → Embedding Provider" style="fontFamily=Arial;rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#DAE8FC;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1162" y="1093" width="176" height="54" as="geometry"/></mxCell><mxCell id="act1-v25" value="Embedding&lt;br&gt;thành công?" style="fontFamily=Arial;rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1"><mxGeometry x="656" y="1174" width="168" height="72" as="geometry"/></mxCell><mxCell id="act1-v26" value="Còn lượt thử (≤ 2,&lt;br&gt;backoff + jitter)?" style="fontFamily=Arial;rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1"><mxGeometry x="855" y="1170" width="190" height="80" as="geometry"/></mxCell><mxCell id="act1-v27" value="status = &lt;b&gt;error&lt;/b&gt; + reason mã hóa&lt;br&gt;(UI ánh xạ sang chuỗi nghiệp vụ)" style="fontFamily=Arial;rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#F8CECC;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="855" y="1273" width="190" height="54" as="geometry"/></mxCell><mxCell id="act1-v28" value="&lt;b&gt;TRANSACTION:&lt;/b&gt; INSERT chunks (embedding + tsvector) và status = &lt;b&gt;ready&lt;/b&gt; (nguyên tử)" style="fontFamily=Arial;rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#DAE8FC;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1162" y="1267" width="176" height="66" as="geometry"/></mxCell><mxCell id="act1-v29" value="" style="fontFamily=Arial;rhombus;html=1;fillColor=#FFF2CC;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="726" y="1376" width="28" height="28" as="geometry"/></mxCell><mxCell id="act1-v30" value="Publish &lt;b&gt;doc.status_changed&lt;/b&gt;&lt;br&gt;(Redis pub/sub, ws:{id}:events)" style="fontFamily=Arial;rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#DAE8FC;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="652" y="1453" width="176" height="54" as="geometry"/></mxCell><mxCell id="act1-v31" value="SSE hub đẩy sự kiện tới trình duyệt&lt;br&gt;GET /v1/events/stream" style="fontFamily=Arial;rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#DAE8FC;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="372" y="1543" width="176" height="54" as="geometry"/></mxCell><mxCell id="act1-v32" value="" style="fontFamily=Arial;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="50" y="1656" width="240" height="8" as="geometry"/></mxCell><mxCell id="act1-v33" value="Cập nhật danh sách: &lt;b&gt;Sẵn sàng&lt;/b&gt; hoặc &lt;b&gt;Lỗi + Thử lại&lt;/b&gt; — không tải lại trang" style="fontFamily=Arial;rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#DAE8FC;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="82" y="1717" width="176" height="66" as="g
<mxfile host="app.diagrams.net" agent="Claude Code" version="24.0.0"><diagram id="seq1" name="Sequence 1 - Hỏi đáp RAG (Luồng A)"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="2422" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="seq1-v2" value="Sequence Diagram — Hỏi đáp RAG có trích dẫn (US-301..305, US-401)" style="fontFamily=Arial;text;html=1;fontSize=16;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="8" width="1200" height="24" as="geometry"/></mxCell><mxCell id="seq1-v3" value="Nguồn: SAD-CWD-001 §3.2 Luồng A, §2.4.3 (hợp đồng SSE), §4.2.2. Mũi tên đặc = đồng bộ; đầu mở = bất đồng bộ (SSE); nét đứt = trả về. Con số độ trễ là [Đề xuất], cần đo thật." style="fontFamily=Arial;text;html=1;fontSize=10;fontStyle=2;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="32" width="1500" height="18" as="geometry"/></mxCell><mxCell id="seq1-v50" value="break" style="fontFamily=Arial;shape=umlFrame;whiteSpace=wrap;html=1;width=54;height=20;fillColor=#F5F5F5;strokeColor=#666666;fontSize=10;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="200" y="406" width="290" height="100" as="geometry"/></mxCell><mxCell id="seq1-v51" value="opt" style="fontFamily=Arial;shape=umlFrame;whiteSpace=wrap;html=1;width=40;height=20;fillColor=#F5F5F5;strokeColor=#666666;fontSize=10;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="378" y="674" width="864" height="172" as="geometry"/></mxCell><mxCell id="seq1-v52" value="par" style="fontFamily=Arial;shape=umlFrame;whiteSpace=wrap;html=1;width=40;height=20;fillColor=#F5F5F5;strokeColor=#666666;fontSize=10;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="400" y="1014" width="430" height="128" as="geometry"/></mxCell><mxCell id="seq1-v53" value="alt" style="fontFamily=Arial;shape=umlFrame;whiteSpace=wrap;html=1;width=40;height=20;
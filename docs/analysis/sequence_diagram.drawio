y"/></mxCell><mxCell id="seq1-v95" value="ref: Nạp tài liệu (Sequence 2) — điều kiện tiên quyết: có ≥ 1 tài liệu trạng thái &lt;b&gt;ready&lt;/b&gt;" style="fontFamily=Arial;shape=note;size=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#666666;fontSize=10;align=left;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="40" y="166" width="330" height="34" as="geometry"/></mxCell><mxCell id="seq1-v96" value="4: validateSession, CSRF, độ dài ≤ 2.000" style="fontFamily=Arial;text;html=1;align=left;verticalAlign=middle;fontSize=10;" vertex="1" parent="1"><mxGeometry x="488" y="366" width="190" height="24" as="geometry"/></mxCell><mxCell id="seq1-v97" value="[phiên hết hạn (401) hoặc vượt hạn mức (429)]" style="fontFamily=Arial;text;html=1;align=left;verticalAlign=middle;fontSize=10;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="254" y="405" width="360" height="18" as="geometry"/></mxCell><mxCell id="seq1-v98" value="[có lịch sử — câu hỏi tiếp nối]" style="fontFamily=Arial;text;html=1;align=left;verticalAlign=middle;fontSize=10;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="432" y="673" width="360" height="18" as="geometry"/></mxCell><mxCell id="seq1-v99" value="[nhánh 1: vector]" style="fontFamily=Arial;text;html=1;align=left;verticalAlign=middle;fontSize=10;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="454" y="1013" width="360" height="18" as="geometry"/></mxCell><mxCell id="seq1-v100" value="[nhánh 2: từ khóa]" style="fontFamily=Arial;text;html=1;align=left;verticalAlign=middle;fontSize=10;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="454" y="1077" width="360" height="18" as="geometry"/></mxCell><mxCell id="seq1-v101" value="11: Reciprocal Rank Fusion → top-M=8; so best score với MIN_RELEVANCE" style="fontFamily=Arial;text;html=1;align=left;verticalAlign=middle;fontSize=10;" vertex="1" parent="1"><mxGeometry x="488" y="1214" width="190" height="24" as="geometry"/></mxCell><mxCell id="seq1-v102" value="{ mọi chunk thuộc workspace, deleted_at IS NULL }" style="fontFamily=Arial;rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#666666;fontSize=10;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="335" y="1256" width="210" height="24" as="geometry"/></mxCell><mxCell id="seq1-v103" value="[không chunk nào đạt ngưỡng liên quan]" style="fontFamily=Arial;text;html=1;align=left;verticalAlign=middle;fontSize=10;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="254" y="1289" width="360" height="18" as="geometry"/></mxCell><mxCell id="seq1-v104" value="[else: có ngữ cảnh]" style="fontFamily=Arial;text;html=1;align=left;verticalAlign=middle;fontSize=10;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="254" y="1389" width="360" height="18" as="geometry"/></mxCell><mxCell id="seq1-v105" value="[còn token]" style="fontFamily=Arial;text;html=1;align=left;verticalAlign=middle;fontSize=10;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="463" y="1531" width="360" height="18" as="geometry"/></mxCell><mxCell id="seq1-v106" value="[timeout 60 s / lỗi AI / circuit breaker mở]" style="fontFamily=Arial;text;html=1;align=left;verticalAlign=middle;fontSize=10;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="273" y="1691" width="360" height="18" as="geometry"/></mxCell><mxCell id="seq1-v107" value="14: verifyCitations — mọi [n] ∈ tập chunk đã truy xuất; loại [n] sai" style="fontFamily=Arial;text;html=1;align=left;verticalAlign=middle;fontSize=10;" vertex="1" parent="1"><mxGeometry x="488" y="1792" width="190" height="24" as="geometry"/></mxCell><mxCell id="seq1-v108" value="[Linh bấm chip trích dẫn]" style="fontFamily=Arial;text;html=1;align=left;verticalAlign=middle;fontSize=10;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="94" y="2029" width="360" height="18" as="geometry"/></mxCell><mxCell id="seq1-e4" value="1: nhập câu hỏi, bấm Gửi" style="fontFamily=Arial;html=1;endArrow=block;endFill=1;endSize=8;strokeWidth=1.2;fontSize=10;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" a
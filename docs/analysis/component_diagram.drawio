<mxfile host="app.diagrams.net" agent="Claude Code" version="24.0.0"><diagram id="cmp" name="Component Diagram - Chat với tài liệu"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1200" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="cmp-v2" value="Component Diagram (UML 2.0) — Chat với tài liệu (MVP) v0.1" style="fontFamily=Arial;text;html=1;fontSize=16;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="8" width="1300" height="24" as="geometry"/></mxCell><mxCell id="cmp-v3" value="Nguồn: SAD-CWD-001 §2.0 (container view), §2.2 (module), §2.3 (hạ tầng dữ liệu), §4.1.1 (ranh giới tin cậy), §4.3 (quan sát). Ball = provided interface, socket = required interface; mũi tên liền = delegation; mũi tên đứt = dependency." style="fontFamily=Arial;text;html=1;fontSize=10;fontStyle=2;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="32" width="1650" height="18" as="geometry"/></mxCell><mxCell id="cmp-v4" value="«system»  Chat với tài liệu — v0.1 (MVP)" style="fontFamily=Arial;rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=12;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="30" y="170" width="1640" height="720" as="geometry"/></mxCell><mxCell id="cmp-v5" value="Client tier (TB-01: không tin cậy)" style="fontFamily=Arial;rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#999999;dashed=1;verticalAlign=top;align=center;fontSize=11;fontStyle=2;arcSize=2;" vertex="1" parent="1"><mxGeometry x="50" y="215" width="190" height="640" as="geometry"/></mxCell><mxCell id="cmp-v6" value="Edge tier" style="fontFamily=Arial;rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#999999;dashed=1;verticalAlign=top;align=center;fontSize=11;fontStyle=2;arcSize=2;" vertex="1" parent="1"><mxGeometry x="255" y="215" width="185" height="640" as="geometry"/></mxCell><mxCell id="cmp-v7" value="Application tier (TB-02)" style="fontFamily=Arial;rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#999999;dashed=1;verticalAlign=top;align=center;fontSize=11;fontStyle=2;arcSize=2;" vertex="1" parent="1"><mxGeometry x="460" y="205" width="450" height="650" as="geometry"/></mxCell><mxCell id="cmp-v8" value="Data tier (TB-03)" style="fontFamily=Arial;rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#999999;dashed=1;verticalAlign=top;align=center;fontSize=11;fontStyle=2;arcSize=2;" vertex="1" parent="1"><mxGeometry x="925" y="190" width="290" height="700" as="geometry"/></mxCell><mxCell id="cmp-v9" value="Background workers" style="fontFamily=Arial;rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#999999;dashed=1;verticalAlign=top;align=center;fontSize=11;fontStyle=2;arcSize=2;" vertex="1" parent="1"><mxGeometry x="1235" y="205" width="420" height="650" as="geometry"/></mxCell><mxCell id="cmp-v104" value="Chú giải" style="fontFamily=Arial;text;html=1;fontStyle=1;fontSize=11;align=left;" vertex="1" parent="1"><mxGeometry x="30" y="1069" width="80" height="20" as="geometry"/></mxCell><mxCell id="cmp-v10" value="«external component»&lt;br&gt;&lt;b&gt;LLM + Embedding Provider&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9px'&gt;Dịch vụ AI ngoài (TB-04) · HTTPS 443 · qua ModelGateway&lt;/font&gt;" style="fontFamily=Arial;shape=module;jettyWidth=14;jettyHeight=7;align=left;spacingLeft=24;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=10;" vertex="1" parent="1"><mxGeometry x="740" y="70" width="420" height="70" as="geometry"/></mxCell><mxCell id="cmp-v11" value="«external component»&lt;br&gt;&lt;b&gt;IdP / SSO (OIDC)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9px'&gt;Nhà cung cấp danh tính nội bộ (TB-04)&lt;/font&gt;" style="fontFamily=Arial;shape=module;jettyWidth=14;jettyHeight=7;align=left;spacingLeft=24;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=10;" vertex="1" parent="1"><mxGeometry x="320" y="70" width="260" height="70" as="geometry"/></mxCell><mxCell id="cmp-v12" value="«external component · alternative»&lt;br&gt;&lt;b&gt;Self-hosted inference&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9px'&gt;Phương án thay thế nếu OQ-006 cấm gửi ra ngoài (OpenAI-compatible)&lt;/font&gt;" style="fontFamily=Arial;shape=module;jettyWidth=14;jettyHeight=7;align=left;spacingLeft=24;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;dashed=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1230" y="70" width="420" height="70" as="geometry"/></mxCell><mxCell id="cmp-v13" value="«external component»&lt;br&gt;&lt;b&gt;Observability backend&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9px'&gt;Prometheus · Grafana · Loki · Tempo (OpenTelemetry)&lt;/font&gt;" style="fontFamily=Arial;shape=module;jettyWidth=14;jettyHeight=7;align=left;spacingLeft=24;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=10;" vertex="1" parent="1"><mxGeometry x="800" y="930" width="320" height="70" as="geometry"/></mxCell><mxCell id="cmp-v14" value="«external component»&lt;br&gt;&lt;b&gt;Secret Manager&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9px'&gt;Vault / secret nền tảng — khóa AI, mật khẩu DB, khóa ký phiên&lt;/font&gt;" style="fontFamily=Arial;shape=module;jettyWidth=14;jettyHeight=7;align=left;spacingLeft=24;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=10;" vertex="1" parent="1"><mxGeometry x="450" y="930" width="320" height="70" as="geometry"/></mxCell><mxCell id="cmp-v15" value="«component»&lt;br&gt;&lt;b&gt;Web SPA&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9px'&gt;React 18 + TS + Vite · TanStack Query · Zustand · SSE client · CSP&lt;/font&gt;" style="fontFamily=Arial;shape=module;jettyWidth=14;jettyHeight=7;align=left;spacingLeft=24;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1"><mxGeometry x="70" y="430" width="150" height="110" as="geometry"/></mxCell><mxCell id="cmp-v16" value="«component»&lt;br&gt;&lt;b&gt;Static hosting / CDN&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9px'&gt;app.[hash].js · index.html no-cache&lt;/font&gt;" style="fontFamily=Arial;shape=module;jettyWidth=14;jettyHeight=7;align=left;spacingLeft=24;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1"><mxGeometry x="270" y="300" width="150" height="80" as="geometry"/></mxCell><mxCell id="cmp-v17" value="«component»&lt;br&gt;&lt;b&gt;Reverse Proxy / TLS&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9px'&gt;TLS 1.2+, HSTS, CSP, rate-limit biên&lt;/font&gt;" style="fontFamily=Arial;shape=module;jettyWidth=14;jettyHeight=7;align=left;spacingLeft=24;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1"><mxGeometry x="270" y="430" width="150" height="100" as="geometry"/></mxCell><mxCell id="cmp-v18" value="«subsystem»&lt;br&gt;&lt;b&gt;API Service&lt;/b&gt; — modular monolith (≥ 2 bản, stateless)" style="fontFamily=Arial;shape=module;jettyWidth=18;jettyHeight=9;align=left;spacingLeft=28;verticalAlign=top;spacingTop=4;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="470" y="200" width="410" height="540" as="geometry"/></mxCell><mxCell id="cmp-v19" value="«component»&lt;br&gt;&lt;b&gt;ModelGateway&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9px'&gt;cổng duy nhất ra dịch vụ AI: timeout · retry · circuit breaker · đếm token&lt;/font&gt;" style="fontFamily=Arial;shape=module;jettyWidth=14;jettyHeight=7;align=left;spacingLeft=24;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1"><mxGeometry x="505" y="230" width="340" height="60" as="geometry"/></mxCell><mxCell id="cmp-v20" value="«component»&lt;br&gt;&lt;b&gt;QnA&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9px'&gt;hỏi đáp RAG, trích dẫn, hội thoại&lt;/font&gt;" style="fontFamily=Arial;shape=module;jettyWidth=14;jettyHeight=7;align=left;spacingLeft=24;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1"><mxGeometry x="505" y="320" width="340" height="60" as="geometry"/></mxCell><mxCell id="cmp-v21" value="«component»&lt;br&gt;&lt;b&gt;IAM&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9px'&gt;xác thực, phiên, RBAC, rate-limit&lt;/font&gt;" style="fontFamily=Arial;shape=module;jettyWidth=14;jettyHeight=7;align=left;spacingLeft=24;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1"><mxGeometry x="505" y="395" width="340" height="60" as="geometry"/></mxCell><mxCell id="cmp-v22" value="«component»&lt;br&gt;&lt;b&gt;Events (SSE hub)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9px'&gt;đẩy doc.status_changed&lt;/font&gt;" style="fontFamily=Arial;shape=module;jettyWidth=14;jettyHeight=7;align=left;spacingLeft=24;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1"><mxGeometry x="505" y="470" width="340" height="60" as="geometry"/></mxCell><mxCell id="cmp-v23" value="«component»&lt;br&gt;&lt;b&gt;Feedback &amp; Metrics (P1)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9px'&gt;đánh giá, WAU, tỷ lệ hữu ích&lt;/font&gt;" style="fontFamily=Arial;shape=module;jettyWidth=14;jettyHeight=7;align=left;spacingLeft=24;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1"><mxGeometry x="505" y="545" width="340" height="60" as="geometry"/></mxCell><mxCell id="cmp-v24" value="«component»&lt;br&gt;&lt;b&gt;Documents&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9px'&gt;tải lên, trạng thái, xóa mềm→cứng&lt;/font&gt;" style="fontFamily=Arial;shape=module;jettyWidth=14;jettyHeight=7;align=left;spacingLeft=24;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1"><mxGeometry x="505" y="630" width="340" height="60" as="geometry"/></mxCell><mxCell id="cmp-v25" value="«subsystem»&lt;br&gt;&lt;b&gt;Worker&lt;/b&gt; — cùng mã nguồn, khác điểm vào (1..n bản)" style="fontFamily=Arial;shape=module;jettyWidth=18;jettyHeight=9;align=left;spacingLeft=28;verticalAlign=top;spacingTop=4;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1250" y="200" width="400" height="540" as="geometry"/></mxCell><mxCell id="cmp-v26" value="«component»&lt;br&gt;&lt;b&gt;ModelGateway «shared lib»&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9px'&gt;adapter HostedProvider / SelfHostedProvider chọn bằng cấu hình&lt;/font&gt;" style="fontFamily=Arial;shape=module;jettyWidth=14;jettyHeight=7;align=left;spacingLeft=24;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1285" y="230" width="330" height="60" as="geometry"/></mxCell><mxCell id="cmp-v27" value="«component»&lt;br&gt;&lt;b&gt;Ingestion&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9px'&gt;trích xuất theo trang → NFC → chunk → embed → ghi chỉ mục (idempotent)&lt;/font&gt;" style="fontFamily=Arial;shape=module;jettyWidth=14;jettyHeight=7;align=left;spacingLeft=24;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1285" y="350" width="330" height="80" as="geometry"/></mxCell><mxCell id="cmp-v28" value="«component»&lt;br&gt;&lt;b&gt;Scheduler / Cleanup&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9px'&gt;quét job kẹt; xóa cứng chunk + PDF ≤ 24 h&lt;/font&gt;" style="fontFamily=Arial;shape=module;jettyWidth=14;jettyHeight=7;align=left;spacingLeft=24;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1285" y="520" width="330" height="80" as="geometry"/></mxCell><mxCell id="cmp-v29" value="«database»&lt;br&gt;&lt;b&gt;WAL archive / Backup&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9px'&gt;PITR 14 ngày · 